# Public browser-safe Supabase values. Use a publishable key, never a secret or service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://bylldx.in

# Server-only values for provider adapters. Keep blank until a provider is selected.
# Required only for live webhook fulfillment. New Supabase secret keys are preferred;
# SUPABASE_SERVICE_ROLE_KEY remains supported for legacy projects.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# When both Razorpay API keys are blank, checkout automatically uses local mock mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
